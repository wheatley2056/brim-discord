<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Company>Brim</Company>
    <Product>Brim Discord</Product>
    <Version>1.0.0</Version>
    <!-- Brim liegt als eigenes Repository daneben (../brim); anders mit -p:BrimRoot=… -->
    <BrimRoot Condition="'$(BrimRoot)' == ''">$(MSBuildThisFileDirectory)..\brim</BrimRoot>
  </PropertyGroup>
</Project>
